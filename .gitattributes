* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.gz binary
*.zip binary

*.csv text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Workflow files are committed with CRLF; normalizing them makes the bot's
# "git add" stage workflow changes, which GITHUB_TOKEN is not allowed to push.
.github/workflows/*.yml -text -eol
